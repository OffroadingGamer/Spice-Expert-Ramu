# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
dist-ssr/
*.tgz
*.zip

# ── Secrets — never commit ────────────────────────────────────
# rundot CLI credentials live in %USERPROFILE%\.rundot_cli, outside this repo.
.env
.env.*
*.pem
*.key
*.p12
.rundot_cli/
.rundot/

# ── Fetched SDK docs (regenerate: npx rundot-sdk-setup -y) ─────
**/rundot/docs/
**/.rundot-docs

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ── OS / editor cruft ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# ── Test / coverage ───────────────────────────────────────────
coverage/

# ── Generation sidecars: keep locally, never publish ──────────
# rundot generate image writes these beside each PNG. They carry the
# prompt, seed, and a storage URL embedding the creator account id.
*.png.json

# ── Supplied audio masters: kept out of git regardless ─────────
# 5 SFX WAVs + an empty BGM folder arrived Sep 4. User confirmed same day
# all five clips are CC0-licensed and need no additional licence, so this
# is no longer a provenance hold — masters just stay out of the repo for
# size, and because the source still isn't named anywhere (including
# LICENSE.txt). Converted, budgeted copies ship from jam-entry/public/audio/
# instead. Plan §7 items 27, 28.
Ramu - The Chef/Audio/
