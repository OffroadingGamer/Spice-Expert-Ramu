# ── Dependencies ──────────────────────────────────────────────
node_modules/

# ── Build output ──────────────────────────────────────────────
dist/
dist-ssr/
*.tgz
*.zip

# ── Secrets — never commit ────────────────────────────────────
# rundot CLI credentials live in %USERPROFILE%\.rundot_cli, outside this repo.
.env
.env.*
*.pem
*.key
*.p12
.rundot_cli/
.rundot/

# ── Fetched SDK docs (regenerate: npx rundot-sdk-setup -y) ─────
**/rundot/docs/
**/.rundot-docs

# ── Logs ──────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-error.log*

# ── OS / editor cruft ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# ── Test / coverage ───────────────────────────────────────────
coverage/

# ── Generation sidecars: keep locally, never publish ──────────
# rundot generate image writes these beside each PNG. They carry the
# prompt, seed, and a storage URL embedding the creator account id.
*.png.json

# ── Supplied audio: held back until provenance/licence is confirmed ────
# 5 SFX WAVs + an empty BGM folder arrived Sep 4. Uncompressed and of
# unknown origin — they must not be published to a public repo until we
# know where they came from. Plan §7 items 27, 28.
Ramu - The Chef/Audio/
